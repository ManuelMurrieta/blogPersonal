{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/ensayo", "destination": "/api/index.php?seccion=ensayo" },
    { "source": "/notas", "destination": "/api/index.php?seccion=notas" },
    { "source": "/sobre-mi", "destination": "/api/index.php?seccion=sobre-mi" }
  ]
}
